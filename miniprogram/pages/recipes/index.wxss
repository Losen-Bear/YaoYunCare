.search{padding:16rpx}
.input{background:#fff;border:1px solid #e5e5e5;border-radius:999px;padding:16rpx 20rpx}
.tags{display:flex;white-space:nowrap;padding:8rpx 16rpx;gap:12rpx}
.tag{display:inline-block;padding:10rpx 16rpx;background:#f2f7f3;border:1px solid #e3eee5;border-radius:999px;color:#134f3a}
.tag.active{background:#0b8a52;color:#fff;border-color:#0b8a52}
.filter-pill{margin:0 16rpx 8rpx;color:#0b2b1e;background:#e9f5ef;padding:8rpx 12rpx;border-radius:8rpx}
.filter-pill .close{margin-left:8rpx}
.list{padding:0 16rpx 16rpx}
.card{display:flex;gap:12rpx;background:#fff;border:1px solid #f0f0f0;border-radius:12rpx;padding:12rpx;margin-top:12rpx}
.cover{width:96rpx;height:96rpx;background:#f1f5f1;border-radius:8rpx}
.info .title{font-size:28rpx;margin-bottom:6rpx}
.info .meta{font-size:22rpx;color:#666}
.empty{text-align:center;color:#888;padding:20rpx}
