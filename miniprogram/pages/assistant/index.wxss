.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8F5EF; /* 配合app.json的背景色 */
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.assistant-wrapper {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 500rpx; /* 根据实际图片高度调整 */
}

.assistant-image {
  width: 400rpx;
  height: 500rpx;
  /* 占位背景，等有真实图片可以移除或保留 */
  background-color: #EAE3D1;
  border-radius: 20rpx;
}

.chat-container {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-msg {
  background-color: #fff;
  padding: 30rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  font-size: 32rpx;
  color: #333;
  text-align: center;
  position: relative;
}

/* 简单的气泡小尾巴 */
.welcome-msg::before {
  content: "";
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 0 20rpx 20rpx 20rpx;
  border-style: solid;
  border-color: transparent transparent #fff transparent;
}
