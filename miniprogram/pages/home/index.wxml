<view class="page">
  <view class="topbar">
    <view class="left">
      <image class="left-logo" src="{{logoSrc}}" mode="aspectFit" lazy-load="true" binderror="onLogoError"></image>
      <block wx:if="{{logoError}}">YY</block>
    </view>
    <view class="title">养生药膳</view>
    <view class="right">
      <view class="avatar" bindtap="goProfile"></view>
    </view>
  </view>
  <view class="banner">
    <swiper indicator-dots autoplay interval="5000" circular style="height: {{swiperHeight}}rpx;">
      <swiper-item wx:for="{{banners}}" wx:key="*this">
        <block wx:if="{{item.src && !item.error}}">
          <image class="banner-image" src="{{item.src}}" mode="widthFix" lazy-load="true" webp="{{true}}" bindtap="onBannerTap" binderror="onBannerError" bindload="onBannerLoad" data-index="{{index}}"></image>
        </block>
        <block wx:else>
          <view class="banner-item" style="height: {{swiperHeight}}rpx;" bindtap="onBannerTap" data-index="{{index}}">{{item.text}}</view>
        </block>
      </swiper-item>
    </swiper>
  </view>
  <view class="actions">
    <view class="sketch-btn main" bindtap="goAssessment">立即测体质</view>
    <view class="row-2">
      <view class="sketch-btn small" bindtap="goMyRecipes">我的药膳方</view>
      <view class="sketch-btn small" bindtap="goSeasonGuide">四季养生指南</view>
    </view>
  </view>
  <view class="section">
    <view class="section-title">今日推荐药膳</view>
    <block wx:if="{{todayRecommend.length}}">
      <block wx:for="{{todayRecommend}}" wx:key="id">
        <view class="recipe-card" bindtap="goRecipeDetail" data-id="{{item.id}}">
            <image class="cover" src="{{item.image_url || defaultCover}}" mode="aspectFill" lazy-load="true" webp="{{true}}" binderror="onRecipeImageError" data-index="{{index}}"></image>
          <view class="info">
            <view class="name">{{item.name}}</view>
            <view class="desc">{{item.effect || '滋补调理'}}</view>
            <view class="tag">适合：{{item.constitution || '-'}}</view>
          </view>
        </view>
      </block>
    </block>
    <view wx:else class="empty">暂无推荐</view>
  </view>
  <view class="section">
    <view class="section-title ink-title text-center">九大体质快速入口</view>
    <view class="grid">
      <block wx:for="{{constitutions}}" wx:key="*this">
        <view class="grid-item" bindtap="goConstitution" data-type="{{item}}">{{item}}</view>
      </block>
    </view>
  </view>
  <view class="section">
    <view class="section-title">热门药膳</view>
    <view class="cats">
      <block wx:for="{{hotCategories}}" wx:key="*this">
        <view class="cat" bindtap="goCategory" data-tag="{{item}}">{{item}}</view>
      </block>
    </view>
  </view>
  <view class="footer">免责提示：药膳为食疗，不替代药物治疗</view>
</view>
