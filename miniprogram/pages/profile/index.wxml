<view class="page">
  <view class="header">
    <image class="avatar" src="{{profile.avatarUrl || defaultAvatar}}"></image>
    <view class="name">{{profile.nickName || '微信用户'}}</view>
  </view>
  <view class="section">
    <view class="section-title">我的体质档案</view>
    <view wx:if="{{archive.main}}">
      <view class="card">
        <view class="main">你的体质：{{archive.main}}</view>
        <view class="time">最近：{{archive.timeText}}</view>
        <view class="row">
          <button size="mini" bindtap="viewReport">查看报告</button>
          <button size="mini" bindtap="retest">重新检测</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty">暂无体质档案</view>
  </view>
  <view class="section">
    <view class="section-title">我的收藏</view>
    <block wx:if="{{favorites.length}}">
      <block wx:for="{{favorites}}" wx:key="id">
        <view class="item" bindtap="goDetail" data-id="{{item.id}}">{{item.name}}</view>
      </block>
    </block>
    <view wx:else class="empty">暂无收藏</view>
  </view>
  <view class="section">
    <view class="section-title">历史检测记录</view>
    <block wx:if="{{history.length}}">
      <block wx:for="{{history}}" wx:key="time">
        <view class="item">{{item.timeText}} · {{item.main}}</view>
      </block>
    </block>
    <view wx:else class="empty">暂无记录</view>
  </view>
  <view class="section">
    <view class="section-title">功能菜单</view>
    <view class="menu">
      <view class="menu-item" bindtap="menu" data-key="science">体质科普</view>
      <view class="menu-item" bindtap="menu" data-key="season">四季养生</view>
      <view class="menu-item" bindtap="menu" data-key="taboo">食材禁忌</view>
      <view class="menu-item" bindtap="menu" data-key="feedback">意见反馈</view>
    </view>
  </view>
  <view class="footer">免责声明：药膳为食疗，不替代药物治疗</view>
</view>
