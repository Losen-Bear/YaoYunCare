.header{display:flex;align-items:center;gap:12rpx;padding:16rpx}
.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#EDE4D5}
.name{font-size:32rpx;font-weight:600}
.section{background:#FCFAF3;margin:12rpx 16rpx;padding:12rpx;border-radius:12rpx;border:1px solid #E0D6C2}
.section-title{font-weight:600;margin-bottom:8rpx;text-align:center}
.card{border:1px dashed #e5e5e5;border-radius:12rpx;padding:12rpx}
.main{font-size:30rpx;margin-bottom:4rpx}
.time{color:#6B7280;font-size:24rpx;margin-bottom:8rpx}
.row{display:flex;gap:12rpx}
.item{padding:10rpx 0;border-bottom:1px solid #f7f7f7}
.empty{text-align:center;color:#888;padding:12rpx}
.menu{display:flex;flex-wrap:wrap;gap:12rpx}
.menu-item{background:#F1ECE2;border:1px solid #E0D6C2;border-radius:8rpx;padding:10rpx 12rpx;color:#2F5E3D;font-size:26rpx}
.footer{text-align:center;color:#888;font-size:22rpx;margin:16rpx}
