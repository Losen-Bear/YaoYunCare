.header{display:flex;align-items:center;gap:12rpx;padding:16rpx}
.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#f1f5f1}
.name{font-size:30rpx;font-weight:600}
.section{background:#fff;margin:12rpx 16rpx;padding:12rpx;border-radius:12rpx;border:1px solid #f0f0f0}
.section-title{font-weight:600;margin-bottom:8rpx}
.card{border:1px dashed #e5e5e5;border-radius:12rpx;padding:12rpx}
.main{font-size:28rpx;margin-bottom:4rpx}
.time{color:#666;font-size:22rpx;margin-bottom:8rpx}
.row{display:flex;gap:12rpx}
.item{padding:10rpx 0;border-bottom:1px solid #f7f7f7}
.empty{text-align:center;color:#888;padding:12rpx}
.menu{display:flex;flex-wrap:wrap;gap:12rpx}
.menu-item{background:#f2f7f3;border:1px solid #e3eee5;border-radius:8rpx;padding:10rpx 12rpx;color:#134f3a}
.footer{text-align:center;color:#888;font-size:22rpx;margin:16rpx}
