.container{padding:20rpx}
.hero-card{background:#0b2b1e;color:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx}
.big{font-size:32rpx;font-weight:700;margin-bottom:6rpx}
.score{opacity:.9}
.sub{color:#666;margin:12rpx 0 8rpx}
.card{background:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03)}
.title{font-size:30rpx;font-weight:600;margin-bottom:8rpx}
.content{font-size:28rpx;color:#333;line-height:1.6}
.actions{display:flex;gap:12rpx;margin:16rpx 0}
.recipe{background:#fafafa;border-radius:8rpx;padding:12rpx;margin:12rpx 0}
.r-name{font-size:28rpx;margin-bottom:8rpx}
.video{width:100%;height:360rpx;margin-bottom:8rpx}
.r-section{font-size:26rpx;color:#444;line-height:1.5}
