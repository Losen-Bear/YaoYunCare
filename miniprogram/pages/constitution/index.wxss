.container{padding:20rpx}
.hero-card{background:#2F5E3D;color:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx}
.big{font-size:32rpx;font-weight:700;margin-bottom:6rpx}
.score{opacity:.9}
.sub{color:#6B7280;margin:12rpx 0 8rpx}
.card{background:#FCFAF3;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx;border:1px solid #E0D6C2}
.title{font-size:30rpx;font-weight:600;margin-bottom:8rpx;text-align:center}
.content{font-size:28rpx;color:#2F2F2F;line-height:1.6}
.actions{display:flex;gap:12rpx;margin:16rpx 0}
.recipe{background:#F1ECE2;border-radius:8rpx;padding:12rpx;margin:12rpx 0;border:1px solid #E0D6C2}
.r-name{font-size:28rpx;margin-bottom:8rpx}
.video{width:100%;height:360rpx;margin-bottom:8rpx}
.r-section{font-size:26rpx;color:#2F2F2F;line-height:1.5}
