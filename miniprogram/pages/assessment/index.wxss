.container{padding:16rpx}
.top{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx}
.back{color:#0b2b1e;padding:8rpx 12rpx;border:1px solid #e5e5e5;border-radius:8rpx}
.title-main{font-size:32rpx;font-weight:600}
.progress{margin-bottom:12rpx}
.progress .text{font-size:26rpx;color:#666;margin-bottom:6rpx}
.progress .bar{height:8rpx;background:#f1f5f1;border-radius:999px;overflow:hidden}
.progress .bar-inner{height:8rpx;background:#0b8a52}
.swiper{height:420rpx}
.qa{background:#fff;border-radius:12rpx;padding:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03)}
.q{font-size:30rpx;color:#333;margin-bottom:18rpx}
.opts{display:flex;flex-direction:column;gap:16rpx}
.radio{display:flex;align-items:center}
.actions{margin-top:16rpx}
