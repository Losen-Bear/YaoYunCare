.container{padding:16rpx}
.title-main{font-size:32rpx;font-weight:600;margin-bottom:8rpx}
.desc{color:#666;margin-bottom:16rpx}
.card{background:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03)}
.section-title{font-size:28rpx;margin-bottom:12rpx}
.list{background:#fff;border-radius:8rpx;padding:8rpx}
.form-item{margin-bottom:12rpx}
.label{font-size:28rpx;color:#333;margin-bottom:8rpx}
.radio{margin-right:20rpx;display:inline-flex;align-items:center}
.qa-item{padding:12rpx 0;border-bottom:1px solid #f5f5f5}
.qa-item:last-child{border-bottom:none}
.q{font-size:28rpx;color:#333;margin-bottom:8rpx}
.opts{display:flex;gap:24rpx}
.actions{display:flex;gap:16rpx;margin-top:16rpx}
.result{margin-top:24rpx}
.title{font-weight:600;font-size:30rpx;margin-bottom:12rpx}
.subtitle{color:#666;margin:8rpx 0}
.recipe{background:#fff;border-radius:8rpx;padding:16rpx;margin-bottom:12rpx}
.name{font-size:28rpx;margin-bottom:8rpx}
.video{width:100%;height:360rpx;margin-bottom:8rpx}
.section{font-size:26rpx;color:#444;line-height:1.5}
