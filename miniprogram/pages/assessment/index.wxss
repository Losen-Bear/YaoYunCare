.container{padding:16rpx}
.top{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx}
.back{color:#2F5E3D;padding:8rpx 12rpx;border:1px solid #E0D6C2;border-radius:8rpx;background:#F1ECE2}
.title-main{font-size:34rpx;font-weight:600}
.title-main{text-align:center}
.progress{margin-bottom:12rpx}
.progress .text{font-size:28rpx;color:#6B7280;margin-bottom:6rpx}
.progress .bar{height:8rpx;background:#EDE4D5;border-radius:999px;overflow:hidden}
.progress .bar-inner{height:8rpx;background:#2F5E3D}
.swiper{height:750rpx}
.qa{background:#FCFAF3;border-radius:12rpx;padding:20rpx;border:1px solid #E0D6C2;height:100%;box-sizing:border-box}
.q{font-size:32rpx;color:#2F2F2F;margin-bottom:24rpx;font-weight:500;line-height:1.5}
.opts{display:flex;flex-direction:column;gap:16rpx;padding-bottom:20rpx}
.radio{display:flex;align-items:center;padding:24rpx;border:2rpx solid #E0D6C2;border-radius:12rpx;background:#FFFFFF;transition:all 0.3s ease;font-size:30rpx;color:#333333}
.radio.checked{background:#E8F0EA;border-color:#2F5E3D;font-weight:500;color:#2F5E3D}
.radio radio, .radio checkbox {margin-right: 12rpx;transform:scale(0.9)}
.actions{margin-top:40rpx;padding-bottom:40rpx}
.btn-submit{background-color:#2F5E3D!important;color:#FFFFFF!important;border-radius:999px;font-size:32rpx;font-weight:bold;padding:24rpx 0;box-shadow:0 8rpx 16rpx rgba(47,94,61,0.2)}
.btn-submit[disabled]{background-color:#C5D3C8!important;color:#FFFFFF!important;box-shadow:none}
