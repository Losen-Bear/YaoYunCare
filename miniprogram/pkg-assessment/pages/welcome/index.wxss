.container{padding:20rpx}
.title{font-size:36rpx;font-weight:600;margin-bottom:6rpx;text-align:center}
.desc{color:#6B7280;margin-bottom:16rpx;font-size:26rpx}
.card{background:#FCFAF3;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx;border:1px solid #E0D6C2}
.section-title{font-size:30rpx;margin-bottom:12rpx}
.form-item{margin-bottom:24rpx}
.label{font-size:30rpx;margin-bottom:12rpx;font-weight:500;color:#333}
.radio-group{display:flex;flex-wrap:wrap;gap:16rpx}
.radio{display:flex;align-items:center;padding:16rpx 24rpx;border:2rpx solid #E0D6C2;border-radius:12rpx;background:#FFFFFF;transition:all 0.3s ease;font-size:28rpx;color:#333333}
.radio.checked{background:#E8F0EA;border-color:#2F5E3D;font-weight:bold;color:#2F5E3D}
.radio radio{margin-right:8rpx;transform:scale(0.8)}
.primary{background:#2F5E3D;color:#fff;margin-top:40rpx;border-radius:999px;font-weight:bold;padding:24rpx 0;box-shadow:0 8rpx 16rpx rgba(47,94,61,0.2)}
.primary[disabled]{background-color:#C5D3C8!important;color:#FFFFFF!important;box-shadow:none}
