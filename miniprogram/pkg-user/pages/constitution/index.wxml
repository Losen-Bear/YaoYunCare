<view class="container">
  <view class="hero-card">
    <view class="hero-title">体质检测结果</view>
    <view class="big">你的体质：{{main}}</view>
    <view class="score">体质匹配度：{{percent}}%</view>
  </view>
  <block wx:for="{{types}}" wx:key="*this" wx:for-item="ctype">
    <view class="card">
      <view class="title-row">
        <view class="title">{{ctype}}</view>
        <view class="title-tag">重点调理</view>
      </view>
      <view class="desc">{{infos[ctype]}}</view>
      <view class="sub">体质解读</view>
      <view class="symptom-grid">
        <view class="symptom-item">
          <view class="symptom-label">典型表现</view>
          <view class="symptom-value">{{detailTextMap[ctype] && detailTextMap[ctype].b}}</view>
        </view>
        <view class="symptom-item">
          <view class="symptom-label">身体倾向</view>
          <view class="symptom-value">{{detailTextMap[ctype] && detailTextMap[ctype].q}}</view>
        </view>
        <view class="symptom-item">
          <view class="symptom-label">性格与作息</view>
          <view class="symptom-value">{{detailTextMap[ctype] && detailTextMap[ctype].x}}</view>
        </view>
      </view>
      <view class="sub">养生建议</view>
      <view class="guide-grid">
        <view class="guide-item"><text class="k">宜吃：</text><text class="v">{{guideTextMap[ctype] && guideTextMap[ctype].eat}}</text></view>
        <view class="guide-item"><text class="k">忌吃：</text><text class="v">{{guideTextMap[ctype] && guideTextMap[ctype].avoid}}</text></view>
        <view class="guide-item"><text class="k">宜做运动：</text><text class="v">{{guideTextMap[ctype] && guideTextMap[ctype].sport}}</text></view>
        <view class="guide-item"><text class="k">少做：</text><text class="v">{{guideTextMap[ctype] && guideTextMap[ctype].less}}</text></view>
      </view>
      <view wx:if="{{grouped[ctype] && grouped[ctype].length}}">
        <view class="sub">为你推荐 · 专属药膳</view>
        <block wx:for="{{grouped[ctype]}}" wx:key="id" wx:for-item="recipe">
          <view class="recipe-card">
            <image class="cover" src="{{recipeImageBrokenMap[ctype + '_' + (recipe.id || index)] ? defaultCover : (recipe.image_url || defaultCover)}}" mode="aspectFill" lazy-load="true" webp="{{true}}" binderror="onRecipeImageError" data-key="{{ctype + '_' + (recipe.id || index)}}"></image>
            <view class="recipe-info">
              <view class="r-name">{{recipe.name}}</view>
              <view class="r-meta">食材：{{recipe.ingredientsText}}</view>
              <view class="r-meta">做法：{{recipe.stepsText}}</view>
              <view class="r-actions">
                <button size="mini" data-id="{{recipe.id}}" bindtap="goDetail">查看做法</button>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
  <view class="actions">
    <button bindtap="retest">重新检测</button>
    <button type="primary" bindtap="saveReport">保存报告</button>
    <button bindtap="goBack">返回</button>
  </view>
</view>
