page, .container {
  background: #F8F5EF;
  min-height: 100vh;
}
.card {
  margin: 120rpx 48rpx;
  padding: 48rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  text-align: center;
}
.logo {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 24rpx;
}
.title {
  font-size: 36rpx;
  color: #2F5E3D;
  margin-bottom: 12rpx;
}
.desc {
  font-size: 28rpx;
  color: #8A8A8A;
  margin-bottom: 32rpx;
}
.login-btn {
  background: #2F5E3D;
  color: #fff;
  border-radius: 12rpx;
}
